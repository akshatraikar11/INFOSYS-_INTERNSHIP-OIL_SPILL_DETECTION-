# Copy to .env and fill in values. Never commit .env.

# ── Backend (backend/server.js) ───────────────────────────────────────────────
# Port the Express server listens on (default: 3001)
PORT=3001

# Base URL of the Python inference service (default: http://127.0.0.1:8000)
INFERENCE_URL=http://127.0.0.1:8000

# Comma-separated list of allowed CORS origins.
# Leave unset to allow all origins (fine for local dev).
# Example for production: CORS_ORIGINS=https://myapp.com,https://www.myapp.com
# CORS_ORIGINS=

# ── Inference (inference/server.py) ──────────────────────────────────────────
# Absolute path to the trained model file (default: ../oil_spill_model.h5)
# MODEL_PATH=/absolute/path/to/oil_spill_model.h5

# ── Frontend build (frontend/vite.config.js) ─────────────────────────────────
# Base path for asset URLs when serving from a sub-path (default: /)
# Example: VITE_BASE=/deepspill/
# VITE_BASE=/
